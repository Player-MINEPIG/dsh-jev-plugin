{
  "name": "dsh-jev-plugin",
  "version": "0.3.5",
  "description": "为 DeepSeek Harness 提供共享结构化决策服务：中文设置、System One 端点与 DSH 普通模型，返回批量判断及完整选项概率。",
  "type": "module",
  "author": "Raúl Lázaro Sánchez (https://github.com/RaulLazaro)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Player-MINEPIG/dsh-jev-plugin.git"
  },
  "homepage": "https://github.com/Player-MINEPIG/dsh-jev-plugin",
  "bugs": {
    "url": "https://github.com/Player-MINEPIG/dsh-jev-plugin/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "UPSTREAM.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "jev",
    "typesafe",
    "system-one",
    "decision",
    "evaluation"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.1-rc.1"
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "types": "lib/index.d.ts",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/schemastery": "3.18.4"
  }
}
